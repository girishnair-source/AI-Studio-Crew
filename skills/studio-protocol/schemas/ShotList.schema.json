{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShotList",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scene",
    "aspect",
    "style",
    "audio",
    "shots"
  ],
  "properties": {
    "schema": {
      "enum": [
        "ShotList/1"
      ]
    },
    "scene": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9_\\-]+$"
    },
    "aspect": {
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "resolution": {
      "enum": [
        "360p",
        "720p",
        "1080p",
        "4k"
      ]
    },
    "style": {
      "type": "string",
      "maxLength": 400
    },
    "audio": {
      "type": "string",
      "maxLength": 400
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_s",
          "camera",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[A-Za-z0-9]+$"
          },
          "duration_s": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15,
            "description": "decided from the script via duration.py; never a default"
          },
          "chain_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "camera": {
            "type": "string",
            "maxLength": 300
          },
          "direction": {
            "type": "string",
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "maxLength": 600
          },
          "staging": {
            "type": "string",
            "maxLength": 300
          },
          "characters": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "refs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "profile": {
            "enum": [
              "presenter",
              "narration",
              "dialogue",
              "cold"
            ]
          },
          "dialogue": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "intention",
                "line"
              ],
              "properties": {
                "speaker": {
                  "type": "string",
                  "maxLength": 40
                },
                "language": {
                  "type": "string",
                  "maxLength": 40
                },
                "intention": {
                  "type": "string",
                  "maxLength": 200
                },
                "line": {
                  "type": "string",
                  "maxLength": 700
                },
                "on_screen": {
                  "type": "boolean"
                }
              }
            }
          },
          "captions": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "text"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "text": {
                  "type": "string",
                  "maxLength": 84
                },
                "emphasis": {
                  "type": "string",
                  "maxLength": 24
                }
              }
            }
          }
        }
      }
    },
    "format": {
      "enum": [
        "shorts",
        "micro-drama",
        "news-bulletin",
        "talking-head",
        "commercial",
        "ads",
        "explainer",
        "launch-video",
        "product-video",
        "short-film",
        "interview-cut",
        "review-cut",
        "personal-video",
        "invitations",
        "intro-logo",
        "text-animation",
        "occasion-slideshow"
      ]
    }
  }
}